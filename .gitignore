# Consolidado el 2026-08-02: el archivo había crecido en dos bloques que se
# solapaban y repetían .env, __pycache__, .npm, .claude, .codex, .cache,
# .local, mi_entorno, .aws, .azure y los temporales de SQLite. Mismo alcance,
# sin duplicados.

# ── Entorno virtual ─────────────────────────────────────────────────────────
mi_entorno/
venv/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.swp
.pytest_cache/

# ── Bases de datos (NO viajan en el repo) ───────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
data/pit_raw/

# ── Logs y cachés ───────────────────────────────────────────────────────────
*.log
.cache/
.npm/
.nvm/
# Cache derivado, lo regenera a1_descomposicion.py
audit_20260714/estrategia/_data.npz
# Marca de arranque único, se recrea sola
data/.g8_autorun_once

# ── Secretos y credenciales ─────────────────────────────────────────────────
.env
.env.*
# ...pero la plantilla SÍ se versiona: es la documentación de qué claves hacen
# falta. Va después de `.env.*` a propósito — en git, la última regla que
# coincide es la que manda.
!.env.example
*.pem
*.key
.streamlit/secrets.toml
.streamlit/credentials.toml
.streamlit/machine_id_v4

# ── Estado de sesión de herramientas (puede contener credenciales) ──────────
.claude/
.claude.json
.claude.json.tmp.*
.codex/
.config/
.vscode-server/

# ── Archivos del $HOME que no son del proyecto ──────────────────────────────
# El repo vive en el home del dueño, así que estos se cuelan solos.
# .aws y .azure son enlaces simbólicos a /mnt/c/Users/... (WSL), no
# directorios, así que hacen falta las DOS formas: el patrón con barra sólo
# casa directorios reales y dejaría los enlaces sin cubrir.
.aws
.aws/
.azure
.azure/
.docker/
.keras/
.local/
.gitconfig
.motd_shown
.sudo_as_admin_successful
.python_history
.bash_history
.bash_logout
.bashrc
.profile
.lesshst

# Worktree aislado de la recuperación de fbq/ (no es parte del proyecto)
/fbq-recuperacion/

# Artefactos generados por la importación del histórico: se rehacen corriendo
# `python3 -m fbq.market.importar_historico`. La caché del schedule sale de una
# API gratis; el informe de pendientes se regenera en cada corrida y su contenido
# vigente queda escrito en docs/REFERENCIA_MERCADO_2026-09.md.
data/schedule_inicios.json
data/importacion_historica_pendientes.csv

# Fines de partido medidos: caché generada por `python3 -m fbq.results.fines`.
data/fines_de_juego.json

# Almacén de anuncios: se genera con `python3 -m fbq.anuncios.capturar`.
data/anuncios.db

# Almacenes generados por la serie prospectiva.
data/anuncios.db
data/prospectiva.db
data/abridores_reales.json
logs/
data/aperturas.db
data/pit_cache_pitcher.db
docs/informe_pareado_vigente.json

