# Plantilla de configuración. Copiar a `.env` y rellenar:
#     cp .env.example .env
#
# `.env` está en .gitignore y nunca debe versionarse. Esta plantilla sí, porque
# es la documentación de qué claves hacen falta.

# ── Requerida ───────────────────────────────────────────────────────────────
# The Odds API (https://the-odds-api.com) — cuotas de moneyline, total y
# runline. Sin ella no hay detección de valor: el pipeline corre y calcula
# probabilidades, pero no tiene contra qué compararlas.
# Es la única fuente del proyecto con cuota limitada.
ODDS_API_KEY=

# ── Opcionales ──────────────────────────────────────────────────────────────
# OpenWeather (https://openweathermap.org/api) — temperatura, viento y lluvia
# por estadio. Si falta, el PASO 5 corre con condiciones neutras y lo registra
# como `weather_source=missing`; no inventa un pronóstico.
OPENWEATHER_API_KEY=

# Modo de publicación del track record. En 'true' (por defecto) cada pick sale
# marcado como cuarentena: se registra y se le captura el cierre, pero no se
# presenta como registro oficial.
# QUARANTINE_MODE=true

# API del tablero React (api/server.py).
# PORT=5001
# FRONTEND_ORIGIN=http://localhost:5173

# ── Escape para desarrollo ──────────────────────────────────────────────────
# FBQ_NO_PERSIST=1 impide TODA escritura en el libro de calibración
# (`game_outcomes`), sin importar el argumento `persist` que reciba
# `run_module()`. Úsalo siempre que llames al pipeline para depurar: una tarde
# de llamadas de diagnóstico dejó 46 filas reales indistinguibles de picks de
# verdad antes de que existiera esta compuerta.
# FBQ_NO_PERSIST=1

# Ruta alternativa a predictions_history.db para scripts de análisis.
# FBQ_DB_PATH=/ruta/a/predictions_history.db

# ── Notas sobre las APIs que NO necesitan clave ─────────────────────────────
# MLB Stats API (statsapi.mlb.com/api/v1), Baseball Savant y FanGraphs son
# gratuitas y sin autenticación. Cubren calendario, abridores, box scores,
# Statcast y los estimadores de pitcheo.
